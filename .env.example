# Local overrides. Everything else (DB name, user, password) is read from the backend env file:
#   ../CoachingQuiz-Ai-Plateform-v2/shared/environment/.env.dev   (HOST=production -> .env.prod)
# Values here win over the backend file.

# Inside docker the DB host is "postgres:5432"; from this laptop it is the published port.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Optional: point at another backend checkout
# BACKEND_DIR=../CoachingQuiz-Ai-Plateform-v2
